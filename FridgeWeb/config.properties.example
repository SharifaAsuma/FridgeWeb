# =====================================================================
#  冷蔵庫の食材管理 設定ファイル(UTF-8で保存してください)
#  このファイルを書き換えたら、アプリを再起動すると反映されます。
#
#  ★ あなたが最初に書き換えるのは db.password だけです。
# =====================================================================

# ---------------------------------------------------------------------
#  1. データベース接続 (MySQL / スキーマ i2c)
# ---------------------------------------------------------------------
db.url=jdbc:mysql://localhost:3306/i2c?serverTimezone=Asia/Tokyo&useSSL=false&allowPublicKeyRetrieval=true
db.user=root
# ★ ここに MySQL のパスワードを書いてください(= のあとに続けて)
db.password=

# ---------------------------------------------------------------------
#  2. テーブル名・列名の対応づけ (i2c.food)
# ---------------------------------------------------------------------
table=food
col.id=ID
col.name=ITEM_NAME
col.expiry=EXPIRATION DATE
col.purchase=PURCHASE_DATE
col.price=PRACE
col.store=SHOP_NAME
col.note=ITEM_MEMO

# 使い切った日の列。ここに日付が入っている食材は、一覧から自動的に隠れます。
col.dispose=DATE OF DISPOSAL

# ジャンルの列は、いまの food テーブルにはありません。
# 同梱の setup.sql を MySQL Workbench で1回実行すると、CATEGORY 列が追加されます。
col.category=CATEGORY

auto.create.table=false

# ID列が自動採番かどうか分からないので false にしています。
# false のときは、登録時に「いまの最大ID + 1」をこのアプリが振ります。
id.auto.increment=false

# ---------------------------------------------------------------------
#  3. ジャンル
# ---------------------------------------------------------------------
categories=肉類🥩,魚類🐟,魚介類🦐,卵🥚,乳製品🥛,野菜類🥕,冷凍食品,調味料,日用品🧻,グローサリー,飲料,その他,未分類

# ---------------------------------------------------------------------
#  3.5. 購入店舗の候補(あらかじめ出しておきたい店名。任意設定)
#     ここに書いていなくても、一度入力した店名は次回から自動で候補に出ます。
#     よく使う店だけ先に登録しておくと、最初から選べて便利です。
# ---------------------------------------------------------------------
store.presets=イオン,ライフ,まいばすけっと,西友,業務スーパー,コストコ

# ---------------------------------------------------------------------
#  4. Webサーバー
# ---------------------------------------------------------------------
server.host=localhost
server.port=8080

# 賞味期限まで何日以内になったら黄色で警告するか
warning.days=3
